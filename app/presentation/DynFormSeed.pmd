{
  "id": "DynFormSeed",
  "securityDomains": [
    "UseDynamicForms"
  ],
  "include": [
    "df.script"
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "postForm",
        "baseUrlType": "app",
        "url": "dynForms",
        "httpMethod": "POST",
        "authType": "sso",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          }
        ],
        "onSend": "<% self.data = {:}; var w = sampleInstanceList.value[0]; self.data.code = (w == 'addr' ? 'TEST:DYN:ADDR' : (w == 'req' ? 'TEST:DYN:REQ' : (w == 'hw' ? 'TEST:DYN:HW' : (w == 'sw' ? 'TEST:DYN:SW' : (w == 'access' ? 'TEST:DYN:ACCESS' : (w == 'big' ? 'TEST:DYN:BIG' : (w == 'lookup' ? 'TEST:DYN:LOOKUP2' : (w == 'biglist' ? 'TEST:DYN:BIGLIST' : (w == 'plain' ? 'TEST:DYN:PLAIN' : (w == 'huge' ? 'TEST:DYN:HUGE' : (w == 'acc' ? 'TEST:DYN:ACC' : (w == 'rep' ? 'TEST:DYN:REP' : (w == 'dep' ? 'TEST:DYN:DEP' : 'TEST:DYN:SMALL'))))))))))))); self.data.formName = 'Test form ' + w; self.data.description = w == 'req' ? 'Shows Hardware or Software details inline and offers the Access form next.' : ''; self.data.version = 1; self.data.status = w == 'acc' ? 'Published' : 'Approved'; self.data.family = self.data.code; self.data; %>"
      },
      {
        "name": "postQuestions",
        "baseUrlType": "app",
        "url": "dynQuestions?bulk=true",
        "httpMethod": "POST",
        "authType": "sso",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          }
        ],
        "onSend": "<% self.data = {:}; var w = sampleInstanceList.value[0]; self.data.data = w == 'addr' ? [{'formCode': 'TEST:DYN:ADDR', 'sortOrder': 1, 'qKey': 'parking', 'qType': 'yesno', 'qLabel': 'Do you need a parking permit at the new address?', 'required': false}, {'formCode': 'TEST:DYN:ADDR', 'sortOrder': 2, 'qKey': 'commute', 'qType': 'number', 'qLabel': 'Commute distance (km)', 'required': false}, {'formCode': 'TEST:DYN:ADDR', 'sortOrder': 3, 'qKey': 'addrNotes', 'qType': 'text', 'qLabel': 'Anything else HR should know about the move?', 'required': false}] : (w == 'req' ? [{'formCode': 'TEST:DYN:REQ', 'sortOrder': 1, 'qKey': 'requester', 'qType': 'text', 'qLabel': 'Requester (from Workday)', 'required': false, 'prefill': 'name'}, {'formCode': 'TEST:DYN:REQ', 'sortOrder': 2, 'qKey': 'requestType', 'qType': 'choice', 'qLabel': 'Request type', 'required': true, 'qOptions': 'hw=Hardware|sw=Software|access=Access'}, {'formCode': 'TEST:DYN:REQ', 'sortOrder': 3, 'qKey': 'hwForm', 'qType': 'subform', 'qLabel': 'Hardware details', 'required': false, 'qOptions': 'TEST:DYN:HW', 'showKey': 'requestType', 'showOp': 'eq', 'showValue': 'hw'}, {'formCode': 'TEST:DYN:REQ', 'sortOrder': 4, 'qKey': 'swForm', 'qType': 'subform', 'qLabel': 'Software details', 'required': false, 'qOptions': 'TEST:DYN:SW', 'showKey': 'requestType', 'showOp': 'eq', 'showValue': 'sw'}, {'formCode': 'TEST:DYN:REQ', 'sortOrder': 5, 'qKey': 'accessNext', 'qType': 'nextform', 'qLabel': 'Access request', 'required': false, 'qOptions': 'TEST:DYN:ACCESS', 'showKey': 'requestType', 'showOp': 'eq', 'showValue': 'access'}, {'formCode': 'TEST:DYN:REQ', 'sortOrder': 6, 'qKey': 'comment', 'qType': 'text', 'qLabel': 'Comment', 'required': false}] : (w == 'hw' ? [{'formCode': 'TEST:DYN:HW', 'sortOrder': 1, 'qKey': 'device', 'qType': 'choice', 'qLabel': 'Device', 'required': true, 'qOptions': 'laptop=Laptop|monitor=Monitor|phone=Phone'}, {'formCode': 'TEST:DYN:HW', 'sortOrder': 2, 'qKey': 'quantity', 'qType': 'number', 'qLabel': 'Quantity', 'required': true}, {'formCode': 'TEST:DYN:HW', 'sortOrder': 3, 'qKey': 'specs', 'qType': 'text', 'qLabel': 'Laptop specs (shown for laptops)', 'required': false, 'showKey': 'device', 'showOp': 'eq', 'showValue': 'laptop'}, {'formCode': 'TEST:DYN:HW', 'sortOrder': 4, 'qKey': 'neededBy', 'qType': 'date', 'qLabel': 'Needed by', 'required': false}] : (w == 'sw' ? [{'formCode': 'TEST:DYN:SW', 'sortOrder': 1, 'qKey': 'software', 'qType': 'text', 'qLabel': 'Software name', 'required': true}, {'formCode': 'TEST:DYN:SW', 'sortOrder': 2, 'qKey': 'licenses', 'qType': 'number', 'qLabel': 'Licenses', 'required': true}] : (w == 'access' ? [{'formCode': 'TEST:DYN:ACCESS', 'sortOrder': 1, 'qKey': 'system', 'qType': 'text', 'qLabel': 'System', 'required': true}, {'formCode': 'TEST:DYN:ACCESS', 'sortOrder': 2, 'qKey': 'reason', 'qType': 'text', 'qLabel': 'Reason', 'required': true}, {'formCode': 'TEST:DYN:ACCESS', 'sortOrder': 3, 'qKey': 'approver', 'qType': 'lookup', 'qLabel': 'Approver', 'required': false, 'lookup': 'workers'}] : (w == 'big' ? [{'formCode': 'TEST:DYN:BIG', 'sortOrder': 1, 'qKey': 'q1', 'qType': 'text', 'qLabel': 'Question 1 (text)', 'required': false}, {'formCode': 'TEST:DYN:BIG', 'sortOrder': 2, 'qKey': 'q2', 'qType': 'number', 'qLabel': 'Question 2 (number)', 'required': false}, {'formCode': 'TEST:DYN:BIG', 'sortOrder': 3, 'qKey': 'q3', 'qType': 'date', 'qLabel': 'Question 3 (date)', 'required': false}, {'formCode': 'TEST:DYN:BIG', 'sortOrder': 4, 'qKey': 'q4', 'qType': 'choice', 'qLabel': 'Question 4 (choice)', 'required': false, 'qOptions': 'a=Option A|b=Option B'}, {'formCode': 'TEST:DYN:BIG', 'sortOrder': 5, 'qKey': 'q5', 'qType': 'yesno', 'qLabel': 'Question 5 (yesno)', 'required': false, 'showKey': 'q4', 'showOp': 'filled', 'showValue': ''}, {'formCode': 'TEST:DYN:BIG', 'sortOrder': 6, 'qKey': 'q6', 'qType': 'text', 'qLabel': 'Question 6 (text)', 'required': false}, {'formCode': 'TEST:DYN:BIG', 'sortOrder': 7, 'qKey': 'q7', 'qT