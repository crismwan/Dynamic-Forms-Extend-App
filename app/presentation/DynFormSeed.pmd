  "presentation": {
    "pageType": "EDIT",
    "title": {
      "type": "title",
      "id": "pageTitle",
      "label": "<% presentationLabels.DynFormSeed_pageTitle_label %>"
    },
    "cancelOverride": {
      "taskId": "DynFormResults"
    },
    "body": {
      "type": "section",
      "id": "bodySection",
      "children": [
        {
          "type": "fieldSet",
          "id": "seedFieldSet",
          "title": "<% presentationLabels.DynFormSeed_seedFieldSet_title %>",
          "children": [
            {
              "type": "instanceList",
              "id": "sampleInstanceList",
              "label": "<% presentationLabels.DynFormSeed_sampleInstanceList_label %>",
              "required": true,
              "instanceList": [
                {
                  "id": "small",
                  "descriptor": "TEST:DYN:SMALL (7 questions with rules)"
                },
                {
                  "id": "big",
                  "descriptor": "TEST:DYN:BIG (generated questions)"
                },
                {
                  "id": "lookup",
                  "descriptor": "TEST:DYN:LOOKUP2 (lookups, search, prefill)"
                },
                {
                  "id": "biglist",
                  "descriptor": "TEST:DYN:BIGLIST (4,000+ option list)"
                },
                {
                  "id": "plain",
                  "descriptor": "TEST:DYN:PLAIN (two text questions)"
                },
                {
                  "id": "req",
                  "descriptor": "TEST:DYN:REQ (request with sub-forms and a next form)"
                },
                {
                  "id": "addr",
                  "descriptor": "TEST:DYN:ADDR (address change follow-up, assigned by a business process)"
                },
                {
                  "id": "hw",
                  "descriptor": "TEST:DYN:HW (hardware sub-form)"
                },
                {
                  "id": "sw",
                  "descriptor": "TEST:DYN:SW (software sub-form)"
                },
                {
                  "id": "access",
                  "descriptor": "TEST:DYN:ACCESS (access follow-up form)"
                },
                {
                  "id": "huge",
                  "descriptor": "TEST:DYN:HUGE (150 questions in one bulk call)"
                },
                {
                  "id": "acc",
                  "descriptor": "TEST:DYN:ACC (acceptance tests: gate, route, French label, confidential answer; Published)"
                },
                {
                  "id": "rep",
                  "descriptor": "TEST:DYN:REP (repeating group: up to 4 dependants)"
                },
                {
                  "id": "dep",
                  "descriptor": "TEST:DYN:DEP (the repeated dependant questions; seed it too)"
                }
              ]
            }
          ]
        }
      ]
    }
  }
