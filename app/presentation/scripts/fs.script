var tierIn = function(map, wid) {
  var t = '';
  for (var r : map ?? []) { if (('' + (r.orgWid ?? '')) == ('' + (wid ?? ''))) { t = '' + (r.tier ?? ''); } }
  t;
};

var first = function(d) {
  (d ?? []).size() > 0 ? d.get(0) : {:};
};

var txt = function(v) {
  empty(v) ? '' : '' + v;
};

var csv = function(s) {
  empty(s) ? [] : ('' + s).split(',').map(x => { x.trim() }).filter(x => { !empty(x) });
};

var dsSel = function(s) {
  csv(s).map(a => { { 'id': a, 'descriptor': a } });
};

var dsJoin = function(ids) {
  empty(ids) ? '' : ids.join(',');
};

var pickOne = function(v) {
  empty(v) ? '' : v[0];
};

var one = function(v, fallback) {
  empty(v) ? [fallback] : [v];
};

var countFor = function(rows, code) {
  var r = (rows ?? []).filter(x => { (x.formCode ?? '') == code });
  r.size() == 0 ? '0' : '' + (r.get(0)['COUNT(workdayID)'] ?? '0');
};

var targetName = function(t) {
  var m = {'app:DynAccessSnap': 'App: Dyn Access Snapshot', 'app:DynAnswer': 'App: Dyn Answer', 'app:DynAnswerConf': 'App: Dyn Answer Confidential', 'app:DynAnswerRestr': 'App: Dyn Answer Restricted', 'app:DynAssign': 'App: Dyn Assign', 'app:DynDept': 'App: Dyn Department', 'app:DynForm': 'App: Dyn Form', 'app:DynKitItem': 'App: Dyn Kit Item', 'app:DynKitTask': 'App: Dyn Kit Task', 'app:DynOrgMap': 'App: Dyn Org Map', 'app:DynPackage': 'App: Dyn Package', 'app:DynQuestion': 'App: Dyn Question', 'app:DynResponse': 'App: Dyn Response', 'app:DynSettings': 'App: Dyn Settings', 'workday:WORKER': 'Workday: Worker', 'workday:SUPERVISORY_ORGANIZATION': 'Workday: Supervisory Organization', 'workday:POSITION': 'Workday: Position', 'workday:POSITION_RESTRICTIONS': 'Workday: Position Restrictions', 'workday:LOCATION': 'Workday: Location', 'workday:COST_CENTER': 'Workday: Cost Center', 'workday:COMPANY': 'Workday: Company', 'workday:JOB_PROFILE': 'Workday: Job Profile', 'workday:CUSTOM_ORGANIZATION': 'Workday: Custom Organization'};
  empty(t) ? '' : (m.get(t) ?? t);
};

var targetFields = function(t) {
  var m = {'app:DynAccessSnap': 'snapKey (TEXT), orgWid (TEXT), jobProfile (TEXT), itemCode (TEXT), holding (INTEGER), peers (INTEGER), peerRule (TEXT), asOf (DATE)', 'app:DynAnswer': 'responseKey (TEXT), formCode (TEXT), qKey (TEXT), rowNumber (INTEGER), textValue (TEXT), numberValue (DECIMAL), dateValue (DATE), refId (TEXT), refDescriptor (TEXT), organization (SINGLE_INSTANCE to SUPERVISORY_ORGANIZATION), position (SINGLE_INSTANCE to POSITION), worker (SINGLE_INSTANCE to WORKER), secretText (TEXT), tier (TEXT), source (TEXT), validUntil (DATE), subjectWid (TEXT), contextKey (TEXT), answeredOn (DATE)', 'app:DynAnswerConf': 'responseKey (TEXT), formCode (TEXT), qKey (TEXT), rowNumber (INTEGER), textValue (TEXT), numberValue (DECIMAL), dateValue (DATE), refDescriptor (TEXT), tier (TEXT), source (TEXT), validUntil (DATE), subjectWid (TEXT), contextKey (TEXT), answeredOn (DATE)', 'app:DynAnswerRestr': 'responseKey (TEXT), formCode (TEXT), qKey (TEXT), rowNumber (INTEGER), textValue (TEXT), numberValue (DECIMAL), dateValue (DATE), refDescriptor (TEXT), tier (TEXT), source (TEXT), validUntil (DATE), subjectWid (TEXT), contextKey (TEXT), answeredOn (DATE)', 'app:DynAssign': 'ref (TEXT), family (TEXT), processType (TEXT), ownerOrg (SINGLE_INSTANCE to SUPERVISORY_ORGANIZATION), ownerWid (TEXT), scope (TEXT), gateOn (BOOLEAN), sectionOrder (INTEGER), tier (TEXT), active (BOOLEAN), origin (TEXT), overrides (TEXT), reach (INTEGER)', 'app:DynDept': 'name (TEXT), org (SINGLE_INSTANCE to SUPERVISORY_ORGANIZATION), orgWid (TEXT), designatedBy (TEXT), effectiveDate (DATE), active (BOOLEAN)', 'app:DynForm': 'code (TEXT), formName (TEXT), version (INTEGER), status (TEXT), description (TEXT), targetObject (TEXT), dataSources (TEXT), requestFramework (BOOLEAN), requestType (TEXT), businessProcess (TEXT), copiedFrom (TEXT), family (TEXT), noFormPolicy (TEXT), failPolicy (TEXT), alsoAssign (TEXT), ownerOrg (SINGLE_INSTANCE to SUPERVISORY_ORGANIZATION), tier (TEXT), processType (TEXT), ownerStatus (TEXT), blocks (TEXT), composeKey (TEXT), slotCount (INTEGER), approvedBy (TEXT), approvedTier (TEXT), reachAtApproval (INTEGER), privacyReason (TEXT), retentionMonths (INTEGER), origin (TEXT), overrides (TEXT), approvedOn (DATE), kind (TEXT), packageCode (TEXT)', 'app:DynKitItem': 'code (TEXT), itemType (TEXT), ownerOrg (SINGLE_INSTANCE to SUPERVISORY_ORGANIZATION), ownerWid (TEXT), scope (TEXT), tier (TEXT), title (TEXT), body (TEXT), dueOffset (INTEGER), fulfillerGroup (TEXT), sensitivity (TEXT), link (TEXT), version (INTEGER), status (TEXT), origin (TEXT), overrides (TEXT), packageCode (TEXT), processType (TEXT), approvedBy (TEXT), active (BOOLEAN)', 'app:DynKitTask': 'key (TEXT), taskType (TEXT), newHire (SINGLE_INSTANCE to WORKER), hireWid (TEXT), hirePerson (TEXT), itemCode (TEXT), title (TEXT), managerNote (TEXT), status (TEXT), requestedBy (TEXT), approvedBy (TEXT), doneBy (TEXT), dueOffset (INTEGER), doneOn (DATE), reason (TEXT), fulfillerGroup (TEXT), bpEvent (TEXT), source (TEXT), sensitivity (TEXT), tier (TEXT), orgWid (TEXT), jobProfile (TEXT)', 'app:DynOrgMap': 'name (TEXT), orgWid (TEXT), org (SINGLE_INSTANCE to SUPERVISORY_ORGANIZATION), parentWid (TEXT), deptWid (TEXT), deptName (TEXT), companyName (TEXT), depth (INTEGER), path (TEXT), active (BOOLEAN), tier (TEXT), workerCount (INTEGER), refreshedOn (DATE)', 'app:DynPackage': 'code (TEXT), name (TEXT), jurisdiction (TEXT), deliveredVersion (INTEGER), enabled (BOOLEAN), enabledBy (TEXT), enabledOn (DATE), readiness (TEXT)', 'app:DynQuestion': 'formCode (TEXT), qKey (TEXT), sortOrder (INTEGER), qType (TEXT), qLabel (TEXT), help (TEXT), required (BOOLEAN), qOptions (TEXT), showKey (TEXT), showOp (TEXT), showValue (TEXT), calc (TEXT), lookup (TEXT), prefill (TEXT), regex (TEXT), regexMessage (TEXT), dataSource (TEXT), sourceField (TEXT), targetField (TEXT), params (TEXT), labels (TEXT), confidential (BOOLEAN), classification (TEXT), libraryKey (TEXT), linkMode (TEXT), reusable (BOOLEAN), validMonths (INTEGER), resetsWhen (TEXT), origin (TEXT), overrides (TEXT)', 'app:DynResponse': 'responseKey (TEXT), formCode (TEXT), status (TEXT), subject (SINGLE_INSTANCE to WORKER), parentKey (TEXT), nextForm (TEXT), bpEvent (TEXT), bpTarget (TEXT), family (TEXT), formVersion (INTEGER), orgName (TEXT), alsoExpected (TEXT), bpPerson (TEXT), subjectOrg (TEXT), department (TEXT), company (TEXT), pinned (TEXT), processType (TEXT)', 'app:DynSettings': 'settingKey (TEXT), budgetEnterprise (INTEGER), budgetDepartment (INTEGER), budgetTeam (INTEGER), reachThreshold (INTEGER), defaultValidMonths (INTEGER), recommendPct (INTEGER), commonPct (INTEGER), minPeers (INTEGER), retainGeneral (INTEGER), retainConfidential (INTEGER), retainRestricted (INTEGER), welcomeDaysBefore (INTEGER)'};
  empty(t) ? 'Pick a business object in Design to see its fields here.' :
    (t.startsWith('workday:') ? 'A Workday object: link an answer to it with a SINGLE_INSTANCE field that targets ' + t.substringAfter('workday:') + '.' :
      (m.get(t) ?? 'Not an app business object in this build.'));
};

var requestText = function(f) {
  (f.requestFramework ?? false) ? ('Yes' + (empty(f.requestType) ? '' : ': ' + f.requestType) + (empty(f.businessProcess) || f.businessProcess == 'noProcess' ? '' : ' (' + f.businessProcess + ')')) : 'No';
};

var dsCount = function(s) {
  csv(s).size() == 0 ? 'None' : csv(s).join(', ');
};

var dsList = function(res) {
  (res ?? []).map(x => { { 'id': x.alias ?? x.id, 'descriptor': (x.descriptor ?? '') + ' (' + (x.alias ?? '') + ')' } });
};

var dsIdList = function(res) {
  (res ?? []).map(x => { { 'id': x.id, 'descriptor': x.alias ?? x.id } });
};

var fieldList = function(res) {
  (res ?? []).map(x => { { 'id': x.alias ?? x.id, 'descriptor': (x.alias ?? '') + ' (' + (x.type ?? '') + ') ' + (x.descriptor ?? '') } });
};

var dsQuery = function(q, appOnly) {
  var s = ('' + (q ?? '')).replace('\'', '').replace('\\', '').trim();
  (appOnly == true) ? 'dynamicforms_kwswrv ' + s : s;
};

var dsPick = function(res, useId) {
  (res ?? []).map(x => { { 'id': (useId ? x.id : x.alias), 'descriptor': (x.alias ?? '') + ' · ' + (empty(x.primaryBusinessObject) ? '' : (x.primaryBusinessObject.descriptor ?? '')) } });
};

var typeCode = function(t) {
  ('' + (t ?? '')).lowerCase().substringBefore(' ').substringBefore('-') + 'Type';
};

var relOf = function(x) {
  empty(x.relatedBusinessObject) ? '' : ('' + (x.relatedBusinessObject.descriptor ?? ''));
};

var fieldPick = function(res, types, rel) {
  var r = ('' + (rel ?? '')).lowerCase().trim();
  (res ?? []).filter(x => { (empty(types) || types.contains(typeCode(x.type))) && (empty(r) || relOf(x).lowerCase().contains(r)) })
    .map(x => { { 'id': x.alias ?? x.id, 'descriptor': (x.alias ?? '') + ' · ' + (x.type ?? '') + (empty(relOf(x)) ? '' : ' of ' + relOf(x)) } });
};

var targets = function(kind) {
  var all = [{'id': 'app:DynAccessSnap', 'descriptor': 'App: Dyn Access Snapshot'}, {'id': 'app:DynAnswer', 'descriptor': 'App: Dyn Answer'}, {'id': 'app:DynAnswerConf', 'descriptor': 'App: Dyn Answer Confidential'}, {'id': 'app:DynAnswerRestr', 'descriptor': 'App: Dyn Answer Restricted'}, {'id': 'app:DynAssign', 'descriptor': 'App: Dyn Assign'}, {'id': 'app:DynDept', 'descriptor': 'App: Dyn Department'}, {'id': 'app:DynForm', 'descriptor': 'App: Dyn Form'}, {'id': 'app:DynKitItem', 'descriptor': 'App: Dyn Kit Item'}, {'id': 'app:DynKitTask', 'descriptor': 'App: Dyn Kit Task'}, {'id': 'app:DynOrgMap', 'descriptor': 'App: Dyn Org Map'}, {'id': 'app:DynPackage', 'descriptor': 'App: Dyn Package'}, {'id': 'app:DynQuestion', 'descriptor': 'App: Dyn Question'}, {'id': 'app:DynResponse', 'descriptor': 'App: Dyn Response'}, {'id': 'app:DynSettings', 'descriptor': 'App: Dyn Settings'}, {'id': 'workday:WORKER', 'descriptor': 'Workday: Worker'}, {'id': 'workday:SUPERVISORY_ORGANIZATION', 'descriptor': 'Workday: Supervisory Organization'}, {'id': 'workday:POSITION', 'descriptor': 'Workday: Position'}, {'id': 'workday:POSITION_RESTRICTIONS', 'descriptor': 'Workday: Position Restrictions'}, {'id': 'workday:LOCATION', 'descriptor': 'Workday: Location'}, {'id': 'workday:COST_CENTER', 'descriptor': 'Workday: Cost Center'}, {'id': 'workday:COMPANY', 'descriptor': 'Workday: Company'}, {'id': 'workday:JOB_PROFILE', 'descriptor': 'Workday: Job Profile'}, {'id': 'workday:CUSTOM_ORGANIZATION', 'descriptor': 'Workday: Custom Organization'}];
  var k = empty(kind) ? 'all' : kind[0];
  all.filter(t => { k == 'all' || (k == 'workday' ? t.id.startsWith('workday:') : !t.id.startsWith('workday:')) });
};

var tRow = function(id, desc) {
  var m = {:};
  m.put('id', id);
  m.put('descriptor', desc);
  m.put('search', (desc + ' ' + id).lowerCase());
  m.put('wd', id.startsWith('workday:'));
  m.put('app', !id.startsWith('workday:'));
  m;
};

var targetRows = function() {
  [{'id': 'app:DynAccessSnap', 'descriptor': 'App: Dyn Access Snapshot'}, {'id': 'app:DynAnswer', 'descriptor': 'App: Dyn Answer'}, {'id': 'app:DynAnswerConf', 'descriptor': 'App: Dyn Answer Confidential'}, {'id': 'app:DynAnswerRestr', 'descriptor': 'App: Dyn Answer Restricted'}, {'id': 'app:DynAssign', 'descriptor': 'App: Dyn Assign'}, {'id': 'app:DynDept', 'descriptor': 'App: Dyn Department'}, {'id': 'app:DynForm', 'descriptor': 'App: Dyn Form'}, {'id': 'app:DynKitItem', 'descriptor': 'App: Dyn Kit Item'}, {'id': 'app:DynKitTask', 'descriptor': 'App: Dyn Kit Task'}, {'id': 'app:DynOrgMap', 'descriptor': 'App: Dyn Org Map'}, {'id': 'app:DynPackage', 'descriptor': 'App: Dyn Package'}, {'id': 'app:DynQuestion', 'descriptor': 'App: Dyn Question'}, {'id': 'app:DynResponse', 'descriptor': 'App: Dyn Response'}, {'id': 'app:DynSettings', 'descriptor': 'App: Dyn Settings'}, {'id': 'workday:WORKER', 'descriptor': 'Workday: Worker'}, {'id': 'workday:SUPERVISORY_ORGANIZATION', 'descriptor': 'Workday: Supervisory Organization'}, {'id': 'workday:POSITION', 'descriptor': 'Workday: Position'}, {'id': 'workday:POSITION_RESTRICTIONS', 'descriptor': 'Workday: Position Restrictions'}, {'id': 'workday:LOCATION', 'descriptor': 'Workday: Location'}, {'id': 'workday:COST_CENTER', 'descriptor': 'Workday: Cost Center'}, {'id': 'workday:COMPANY', 'descriptor': 'Workday: Company'}, {'id': 'workday:JOB_PROFILE', 'descriptor': 'Workday: Job Profile'}, {'id': 'workday:CUSTOM_ORGANIZATION', 'descriptor': 'Workday: Custom Organization'}].map(t => { tRow(t.id, t.descriptor) });
};

var tDef = function(id, label, kind, key) {
  var m = {:};
  m.put('id', id);
  m.put('label', label);
  m.put('kind', kind);
  m.put('key', key);
  m;
};

var targetDefs = function() {
  [tDef('appObjects', 'This app\'s business objects', 'flag', 'app'), tDef('workdayObjects', 'Workday objects', 'flag', 'wd'), tDef('az', 'A to Z', 'az', '')];
};

var targetSel = function(t) {
  empty(t) ? [] : [tRow(t, targetName(t))];
};

var targetFind = function(q, kind) {
  var s = ('' + (q ?? '')).lowerCase().trim();
  targets(kind).filter(t => { empty(s) || ('' + t.descriptor).lowerCase().contains(s) || ('' + t.id).lowerCase().contains(s) });
};

var copyText = function(dsEntries, fieldId) {
  var ds = empty(dsEntries) ? '' : ('' + (dsEntries[0].descriptor ?? '')).substringBefore(' · ');
  empty(fieldId) ? (empty(ds) ? 'Pick a data source, then a field.' : 'Data source: ' + ds + '. Now pick a field.') : 'Data source: ' + ds + '   Source field: ' + fieldId[0];
};

var codeErr = function(v) {
  var s = txt(v);
  empty(s) ? '' : (s.contains(' ') ? 'No spaces: use colons, e.g. HR:LEAVE:REQUEST.' : (s.upperCase() != s ? 'Use capital letters, e.g. HR:LEAVE:REQUEST.' : ''));
};

var rxTest = function(rx, sample) {
  empty(rx) ? 'Type a regular expression and a sample answer.' : (validate:match(rx, txt(sample)) ? 'Matches: this answer would be accepted.' : 'Does not match: the fill page would show the question message.');
};

{
  "first": first, "tierIn": tierIn, "txt": txt, "csv": csv, "dsSel": dsSel, "dsJoin": dsJoin, "pickOne": pickOne, "one": one,
  "countFor": countFor, "targetName": targetName, "targetFields": targetFields, "requestText": requestText,
  "dsCount": dsCount, "dsList": dsList, "dsIdList": dsIdList, "fieldList": fieldList, "dsQuery": dsQuery, "dsPick": dsPick, "typeCode": typeCode, "relOf": relOf,
  "fieldPick": fieldPick, "targets": targets, "tRow": tRow, "targetRows": targetRows, "tDef": tDef, "targetDefs": targetDefs, "targetSel": targetSel, "targetFind": targetFind, "copyText": copyText,
  "codeErr": codeErr, "rxTest": rxTest
}
