{
  "id": "DynFormPrune",
  "securityDomains": [
    "UseDynamicForms"
  ],
  "script": "<% var keep = function(c) { '|TEST:DYN:ADDR|TEST:DYN:SW|'.contains('|' + ('' + (c ?? '')).substringBefore('@') + '|'); }; var allQs = function() { list:flatten([ownQs0.data ?? [], ownQs1.data ?? [], ownQs2.data ?? []]); }; var dropForms = function() { (ownForms.data ?? []).filter(r => { !keep(r.code) }); }; var dropQs = function() { allQs().filter(r => { !keep(r.formCode) }); }; var ids = function(l) { l.map(r => { r.id }).join(','); }; var part = function(i) { var all = dropQs(); var a = i * 100; a >= all.size() ? '' : ids(all.subList(a, (a + 100) > all.size() ? all.size() : (a + 100))); }; %>",
  "endPoints": [
    {
      "name": "ownForms",
      "baseUrlType": "app",
      "url": "dynForms?limit=100",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        }
      ]
    },
    {
      "name": "ownQs0",
      "baseUrlType": "app",
      "url": "dynQuestions?limit=100",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        }
      ]
    },
    {
      "name": "ownQs1",
      "baseUrlType": "app",
      "url": "dynQuestions?limit=100&offset=100",
      "authType": "sso"
    },
    {
      "name": "ownQs2",
      "baseUrlType": "app",
      "url": "dynQuestions?limit=100&offset=200",
      "authType": "sso"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "launchPrune",
        "baseUrlType": "orchestrate",
        "url": "/FormPrune/launch",
        "httpMethod": "POST",
        "authType": "sso",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          }
        ],
        "exclude": "<% dropForms().size() + dropQs().size() == 0 %>",
        "onSend": "<% self.data = {:}; self.data.forms = ids(dropForms()); self.data.q1 = part(0); self.data.q2 = part(1); self.data.q3 = part(2); self.data; %>"
      }
    ]
  },
  "presentation": {
    "pageType": "EDIT",
    "title": {
      "type": "title",
      "id": "pageTitle",
      "label": "<% presentationLabels.DynFormPrune_pageTitle_label %>"
    },
    "cancelOverride": {
      "taskId": "Home"
    },
    "body": {
      "type": "section",
      "id": "bodySection",
      "children": [
        {
          "type": "fieldSet",
          "id": "pruneFieldSet",
          "title": "<% presentationLabels.DynFormPrune_pruneFieldSet_title %>",
          "children": [
            {
              "type": "text",
              "id": "keepText",
              "label": "<% presentationLabels.DynFormPrune_keepText_label %>",
              "enabled": false,
              "value": "<% 'TEST:DYN:ADDR, TEST:DYN:SW (every version)' %>"
            },
            {
              "type": "text",
              "id": "dropFormsText",
              "label": "<% presentationLabels.DynFormPrune_dropFormsText_label %>",
              "enabled": false,
              "value": "<% '' + dropForms().size() + ' of ' + (ownForms.data ?? []).size() %>"
            },
            {
              "type": "text",
              "id": "dropQsText",
              "label": "<% presentationLabels.DynFormPrune_dropQsText_label %>",
              "enabled": false,
              "value": "<% '' + dropQs().size() + ' of ' + allQs().size() + (allQs().size() >= 300 ? ' (300 read: run it again after OK)' : '') %>"
            },
            {
              "type": "text",
              "id": "dropCodesText",
              "label": "<% presentationLabels.DynFormPrune_dropCodesText_label %>",
              "enabled": false,
              "value": "<% dropForms().map(r => { (r.code ?? '') + '@' + ('' + (r.version ?? '')).substringBefore('.') }).join(', ') %>"
            }
          ]
        }
      ]
    }
  }
}
